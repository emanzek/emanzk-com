/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Only rule under /assets/ — overlapping rules are CONCATENATED, not overridden,
# so a broader /assets/* rule here would produce two Cache-Control values and the
# shorter one would win. Everything else falls back to revalidate-on-load, which is
# what unhashed rack.js/hud.js/css need anyway.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable
