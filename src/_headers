/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Only rule under /assets/ — overlapping rules are CONCATENATED, not overridden,
# so a broader /assets/* rule here would produce two Cache-Control values and the
# shorter one would win. Everything else falls back to revalidate-on-load, which is
# what unhashed rack.js/hud.js/css need anyway.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# Pinned library builds. The version is in the filename, so an upgrade lands on a new path and this
# can sit in cache for a year. Never overwrite a file under here in place - immutable means even a
# reload will not revalidate, and a stale three.js against a fresh rack.js is a blank page.
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable
